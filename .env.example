# Inherits B2B_* from b2b-agent-toolkit
B2B_USE_MOCKS=true
B2B_M365_TENANT_ID=
B2B_M365_CLIENT_ID=
B2B_M365_CLIENT_SECRET=
B2B_M365_DOMAIN=

# Anthropic — optional. With the key, drafts are LLM-generated; otherwise stub.
ANTHROPIC_API_KEY=
OUTREACH_MODEL=claude-sonnet-4-6

# UPN of the mailbox where drafts will be created (must be in your tenant)
OUTREACH_SENDER_UPN=

# Tone profile — values: "peer-cynical", "consultant", "neutral", "warm"
OUTREACH_TONE=peer-cynical
